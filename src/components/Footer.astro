---
import { SITE } from '../lib/site';
import { DEBT_FREEDOM_VERSES } from '../lib/verses';

const year = new Date().getFullYear();
const defaultVerse = DEBT_FREEDOM_VERSES[0];
---

<footer class="border-t border-slate-100 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="border-b border-slate-100 pb-6 text-center">
      <blockquote id="footer-verse-text" class="text-sm italic text-slate-600">
        &ldquo;{defaultVerse.text}&rdquo;
      </blockquote>
      <cite id="footer-verse-reference" class="mt-2 block text-xs not-italic text-slate-400">
        {defaultVerse.reference}
      </cite>
    </div>

    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-slate-900">{SITE.name}</p>
        <p class="mt-1 max-w-sm text-sm text-slate-500">{SITE.description}</p>
      </div>

      <div class="flex flex-wrap gap-x-10 gap-y-6 text-sm">
        <div class="flex flex-col gap-2">
          <span class="font-semibold text-slate-900">Product</span>
          <a href="/features" class="text-slate-500 hover:text-slate-900">
            Features
          </a>
          <a href={SITE.appUrl} class="text-slate-500 hover:text-slate-900">
            Open the app
          </a>
          <a href="/changelog" class="text-slate-500 hover:text-slate-900">
            Changelog
          </a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-semibold text-slate-900">Open source</span>
          <a href="/open-source" class="text-slate-500 hover:text-slate-900">
            Why open source
          </a>
          <a href={SITE.repoUrl} class="text-slate-500 hover:text-slate-900">
            GitHub repo
          </a>
          <a href="/donate" class="text-slate-500 hover:text-slate-900">
            Donate
          </a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-semibold text-slate-900">Company</span>
          <a href="/about" class="text-slate-500 hover:text-slate-900">
            About us
          </a>
        </div>
      </div>
    </div>

    <p class="mt-8 text-xs text-slate-400">
      &copy; {year} {SITE.name}. Released under the MIT License. Scripture quotations marked (CSB)
      are from the Christian Standard Bible&reg;, copyright 2017 by Holman Bible Publishers. Used by
      permission.
    </p>
  </div>
</footer>

<script>
  import { DEBT_FREEDOM_VERSES } from '../lib/verses';

  const verse = DEBT_FREEDOM_VERSES[Math.floor(Math.random() * DEBT_FREEDOM_VERSES.length)];
  const textEl = document.getElementById('footer-verse-text');
  const referenceEl = document.getElementById('footer-verse-reference');

  if (textEl && referenceEl) {
    textEl.textContent = `“${verse.text}”`;
    referenceEl.textContent = verse.reference;
  }
</script>
