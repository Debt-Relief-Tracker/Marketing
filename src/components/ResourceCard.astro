---
import type { Resource } from '../lib/resources';
import { typeLabel, tagLabel } from '../lib/resources';

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
---

<article class="rounded-xl border border-slate-100 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
    <a
      href={`/resources/type/${resource.type}`}
      class="bg-brand-50 text-brand-700 rounded-full px-2.5 py-0.5 font-medium hover:underline"
    >
      {typeLabel(resource.type)}
    </a>
    <time datetime={resource.date.toISOString()}>
      {resource.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
    </time>
  </div>
  <h2 class="mt-3 text-lg font-semibold text-slate-900">
    <a href={`/resources/${resource.slug}`} class="hover:text-brand-700">
      {resource.title}
    </a>
  </h2>
  <p class="mt-2 text-sm text-slate-600">{resource.description}</p>
  {resource.tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2 text-xs">
      {resource.tags.map((tag) => (
        <li>
          <a
            href={`/resources/tag/${tag}`}
            class="rounded-full bg-slate-100 px-2.5 py-0.5 text-slate-600 hover:underline"
          >
            #{tagLabel(tag)}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>
