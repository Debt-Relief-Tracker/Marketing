---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
---

<BaseLayout title="Message sent" description="Thanks for reaching out to Debt Relief Tracker.">
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <h1 class="text-3xl font-bold text-slate-900">Thanks — we got your message.</h1>
    <p class="mt-4 text-slate-600">
      We'll reply to the email address you provided. Keep an eye out for a confirmation email too.
    </p>
    <CTAButton href="/" class="mt-8">
      Back to home
    </CTAButton>
  </section>
</BaseLayout>
