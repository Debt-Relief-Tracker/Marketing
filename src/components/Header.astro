---
import CTAButton from './CTAButton.astro';
import { SITE } from '../lib/site';

const navLinks = [
  { href: '/features', label: 'Features' },
  { href: '/open-source', label: 'Open Source' },
  { href: '/about', label: 'About' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/donate', label: 'Donate' },
];
---

<header class="border-b border-slate-100">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-bold text-slate-900">
      {SITE.name}
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-slate-600 hover:text-slate-900">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={SITE.repoUrl}
        class="hidden text-sm font-medium text-slate-600 hover:text-slate-900 sm:inline"
      >
        GitHub
      </a>
      <CTAButton href={SITE.appUrl}>Get started free</CTAButton>
    </div>
  </div>

  <nav class="flex items-center gap-6 overflow-x-auto border-t border-slate-100 px-6 py-2 md:hidden">
    {navLinks.map((link) => (
      <a href={link.href} class="whitespace-nowrap text-sm font-medium text-slate-600">
        {link.label}
      </a>
    ))}
  </nav>
</header>
