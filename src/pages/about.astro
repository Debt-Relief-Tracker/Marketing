---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import { SITE } from '../lib/site';
import couplePhoto from '../assets/Kyle+Stephanie.jpeg';
---

<BaseLayout
  title="About Us"
  description="Meet Kyle and Stephanie, the couple behind Debt Relief Tracker — building the tool we wish we had on our own debt-free journey."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="mt-12 text-3xl font-bold text-slate-900 sm:text-4xl">About us</h1>
    <div class="mt-8 flex flex-col gap-10 md:flex-row md:items-start">
      <div class="space-y-8 text-slate-600 md:flex-1">
        <p class="text-lg text-slate-600">
          We're Kyle and Stephanie — and like a lot of people who use {SITE.name}, we're on our own
          journey out of debt.
        </p>
        <p>
          Kyle is a software developer, and Stephanie is a geotechnical engineer. We got married on
          May 16, 2026, and started combining our finances, our goals, and — like most newly married
          couples — our debt.
        </p>
        <p>
          We built {SITE.name} because we wanted a clear, honest picture of where we stood and a
          real plan to get to zero, without paying for another subscription or handing our financial
          data to a company we couldn't verify. So Kyle built it, we started using it ourselves, and
          we decided to open source it and offer it free to anyone else working toward the same
          thing.
        </p>
        <p>
          We're both strong Christians, and our faith shapes how we think about money, debt, and
          generosity — that's part of why you'll find a Bible verse about financial freedom at the
          bottom of every page on this site.
        </p>
      </div>

      <Image
        src={couplePhoto}
        alt="Kyle and Stephanie smiling together"
        width={450}
        class="mx-auto w-full max-w-xs rounded-2xl shadow-md md:mx-0 md:w-72 md:shrink-0"
      />
    </div>

    <div class="mt-12 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <CTAButton href={SITE.appUrl}>Start your own journey</CTAButton>
      <CTAButton href={SITE.repoUrl} variant="secondary">
        View the code
      </CTAButton>
    </div>
  </section>
</BaseLayout>
