# Polls Debt-Relief-Tracker/Tracker for new GitHub releases and triggers a Cloudflare Pages
# rebuild when one appears, so /changelog (built from release data at build time) stays current.
#
# This lives in THIS repo (not the Tracker repo) by design, so it's a poll rather than a true
# webhook — updates land within one poll interval, not instantly. See docs/blog-plan.md's sibling
# note in the plan file for the trade-off discussion.
#
# Setup required before this workflow can actually trigger rebuilds:
#   1. Create a Cloudflare Pages Deploy Hook for this site's Pages project.
#   2. Add its URL as an encrypted repository SECRET (Settings > Secrets and variables > Actions >
#      Secrets tab) named CF_DEPLOY_HOOK_URL. Do NOT add it as a plaintext Variable — anyone with
#      this URL can trigger a rebuild.
name: Watch Tracker releases

on:
  schedule:
    - cron: '*/15 * * * *'
  workflow_dispatch: {}

permissions:
  contents: read
  actions: write # required to read/write the LAST_SEEN_RELEASE_TAG repo variable

env:
  GH_TOKEN: ${{ github.token }}
  TRACKER_REPO: Debt-Relief-Tracker/Tracker

jobs:
  check-release:
    runs-on: ubuntu-latest
    steps:
      - name: Fetch latest Tracker release
        id: latest
        run: |
          tag=$(gh api "repos/${TRACKER_REPO}/releases/latest" --jq .tag_name)
          echo "tag=${tag}" >> "$GITHUB_OUTPUT"

      - name: Read last-seen release tag
        id: previous
        run: |
          if tag=$(gh variable get LAST_SEEN_RELEASE_TAG --repo "${GITHUB_REPOSITORY}" 2>/dev/null); then
            echo "tag=${tag}" >> "$GITHUB_OUTPUT"
            echo "known=true" >> "$GITHUB_OUTPUT"
          else
            echo "known=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Record current tag as seen
        if: steps.previous.outputs.known == 'false' || steps.previous.outputs.tag != steps.latest.outputs.tag
        run: |
          gh variable set LAST_SEEN_RELEASE_TAG --repo "${GITHUB_REPOSITORY}" --body "${{ steps.latest.outputs.tag }}"

      - name: Trigger Cloudflare Pages rebuild
        # Skip on the very first run (nothing "known" yet) so we don't fire a rebuild for a
        # release that predates this workflow's setup — only rebuild on an actual *change*.
        if: steps.previous.outputs.known == 'true' && steps.previous.outputs.tag != steps.latest.outputs.tag
        run: |
          if [ -z "${{ secrets.CF_DEPLOY_HOOK_URL }}" ]; then
            echo "::error::CF_DEPLOY_HOOK_URL secret is not set — cannot trigger a rebuild. Add it under Settings > Secrets and variables > Actions > Secrets." >&2
            exit 1
          fi
          curl --fail --silent --show-error -X POST "${{ secrets.CF_DEPLOY_HOOK_URL }}"
